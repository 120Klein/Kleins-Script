local function stopSpectate()
    if Spec.Conn then Spec.Conn:Disconnect(); Spec.Conn=nil end
    Spec.Target=nil
    local hum=getHumanoid(); if hum then workspace.CurrentCamera.CameraSubject=hum end
end
local function spectatePlayer(player)
    if not player or not player.Character then Library:Notify('No character.',2); return end
    local root=player.Character:FindFirstChild("HumanoidRootPart")
    if not root then Library:Notify('No HumanoidRootPart.',2); return end
    if Spec.Target==root then stopSpectate(); Library:Notify('Stopped spectating.',2); return end
    Spec.Target=root
    if Spec.Conn then Spec.Conn:Disconnect(); Spec.Conn=nil end
    Spec.Conn=RunService.Heartbeat:Connect(function()
        if not Spec.Target then return end
        if not Spec.Target.Parent then
            Spec.Target=nil; local hum=getHumanoid()
            if hum then workspace.CurrentCamera.CameraSubject=hum end; return
        end
        workspace.CurrentCamera.CameraSubject=Spec.Target
        pcall(function() LocalPlayer:RequestStreamAroundAsync(Spec.Target.Position,0.1) end)
    end)
    Library:Notify('Spectating: '..player.Name,3)
end

