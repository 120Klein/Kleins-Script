    for o,t in pairs(Vis.TexSaved) do if o and o.Parent then o.Transparency=t end end
    Vis.MatSaved={}; Vis.TexSaved={}
end
local function removePostFX()
    Vis.FXSaved={}
    for _,o in ipairs(game:GetService("Lighting"):GetChildren()) do
        if o:IsA("PostEffect") then Vis.FXSaved[o]=o.Enabled; o.Enabled=false end
    end
end
local function restorePostFX()
    for o,s in pairs(Vis.FXSaved) do if o and o.Parent then o.Enabled=s end end
    Vis.FXSaved={}
end
local function applyFullBright()
    local L=game:GetService("Lighting")
    FB.SavedAmbient=L.Ambient; FB.SavedOutdoor=L.OutdoorAmbient
    FB.SavedBright=L.Brightness; FB.SavedColorShift=L.ColorShift_Bottom
    L.Ambient=Color3.new(1,1,1); L.OutdoorAmbient=Color3.new(1,1,1)
    L.Brightness=2; L.ColorShift_Bottom=Color3.new(0,0,0)
    FB.Conn=L:GetPropertyChangedSignal("Brightness"):Connect(function() if FB.Enabled then L.Brightness=2 end end)
end
local function removeFullBright()
    if FB.Conn then FB.Conn:Disconnect(); FB.Conn=nil end
    local L=game:GetService("Lighting")
    if FB.SavedAmbient    then L.Ambient=FB.SavedAmbient end
    if FB.SavedOutdoor    then L.OutdoorAmbient=FB.SavedOutdoor end
    if FB.SavedBright     then L.Brightness=FB.SavedBright end
    if FB.SavedColorShift then L.ColorShift_Bottom=FB.SavedColorShift end
end
local function lockTime(h)
