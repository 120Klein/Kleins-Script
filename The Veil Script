do
    local function getNpcList()
        local list={}
        local folder=workspace:FindFirstChild("NPCs")
        if folder then
            for _,npc in ipairs(folder:GetChildren()) do
                if npc:IsA("Model") then table.insert(list,npc.Name) end
            end
        end
        if #list==0 then table.insert(list,"(no NPCs)") end
        return list
    end
    local G=Tabs.Misc:AddRightGroupbox('NPC Teleport')
    G:AddDropdown('NpcTeleportDropdown',{Text='Select NPC',Values=getNpcList(),Default=1})
    G:AddButton('Teleport to NPC',function()
        local sel=Options.NpcTeleportDropdown.Value
        if not sel or sel=="(no NPCs)" then Library:Notify('No NPC selected.',2);return end
        local folder=workspace:FindFirstChild("NPCs"); if not folder then Library:Notify('NPCs folder not found.',2);return end
        local npc=folder:FindFirstChild(sel); if not npc then Library:Notify('NPC not found.',2);return end
        local root=getRoot(); if not root then Library:Notify('No character.',2);return end
        local npcRoot=npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart or npc:FindFirstChildOfClass("BasePart")
        if not npcRoot then Library:Notify('NPC has no root part.',2);return end
        task.spawn(function()
            pcall(function() LocalPlayer:RequestStreamAroundAsync(npcRoot.Position,2) end)
            root.CFrame=npcRoot.CFrame+Vector3.new(0,5,0)
            Library:Notify('Teleported to '..sel,2)
        end)
    end)
    G:AddButton('Refresh NPC List',function()
        Options.NpcTeleportDropdown:SetValues(getNpcList()); Library:Notify('NPC list refreshed.',2)
    end)
end

