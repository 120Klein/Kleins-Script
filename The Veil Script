local function setProximity(s)
    Prox.Enabled=s
    if Prox.Conn then Prox.Conn:Disconnect(); Prox.Conn=nil end
    Prox.LastAlert={}
    if not s then return end
    Prox.Conn=RunService.Heartbeat:Connect(function()
        local mr=getRoot(); if not mr then return end; local now=tick()
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LocalPlayer then continue end
            local char=p.Character; local root=char and char:FindFirstChild("HumanoidRootPart"); if not root then continue end
            local dist=math.floor((root.Position-mr.Position).Magnitude)
            if dist<=Prox.Range then
                local last=Prox.LastAlert[p]
                if not last or (now-last)>=Prox.Cooldown then
                    Prox.LastAlert[p]=now; Library:Notify(string.format("%s nearby - %d studs",p.Name,dist),6)
                end
            else Prox.LastAlert[p]=nil end
        end
    end)
end
Players.PlayerRemoving:Connect(function(p) Prox.LastAlert[p]=nil end)

