-- [CHANGED] applyNoFog now also spawns a periodic refresh loop every 3 seconds
--           so entering new areas doesn't bring fog back
local function applyNoFog()
    if Fog.Timer then task.cancel(Fog.Timer); Fog.Timer=nil end  -- safety: cancel any existing timer
    local L=game:GetService("Lighting")
    Fog.OrigEnd=L.FogEnd; Fog.OrigStart=L.FogStart
    L.FogEnd=100000; L.FogStart=100000
    for _,o in ipairs(L:GetChildren()) do
        if o:IsA("Atmosphere") then
            Fog.SavedAtmo={Density=o.Density,Offset=o.Offset,Haze=o.Haze,Glare=o.Glare}
            o.Density=0;o.Offset=0;o.Haze=0;o.Glare=0
        end
    end
    Fog.Conn=L:GetPropertyChangedSignal("FogEnd"):Connect(function() if Fog.Enabled then L.FogEnd=100000 end end)
    Fog.DescConn=L.DescendantAdded:Connect(function(o)
        if Fog.Enabled and o:IsA("Atmosphere") then o.Density=0;o.Offset=0;o.Haze=0;o.Glare=0 end
    end)
    -- Periodic re-apply every 3 seconds to survive area transitions
    Fog.Timer=task.spawn(function()
        while Fog.Enabled do
            local Lc=game:GetService("Lighting")
            Lc.FogEnd=100000; Lc.FogStart=100000
            for _,o in ipairs(Lc:GetChildren()) do
                if o:IsA("Atmosphere") then o.Density=0;o.Offset=0;o.Haze=0;o.Glare=0 end
            end
            task.wait(3)
        end
    end)
end
-- [CHANGED] removeNoFog now also cancels the periodic timer
local function removeNoFog()
    if Fog.Conn     then Fog.Conn:Disconnect();     Fog.Conn=nil     end
    if Fog.DescConn then Fog.DescConn:Disconnect(); Fog.DescConn=nil end
    if Fog.Timer    then task.cancel(Fog.Timer);    Fog.Timer=nil    end
    local L=game:GetService("Lighting")
    if Fog.OrigEnd   then L.FogEnd=Fog.OrigEnd     end
    if Fog.OrigStart then L.FogStart=Fog.OrigStart end
    for _,o in ipairs(L:GetChildren()) do
        if o:IsA("Atmosphere") and Fog.SavedAtmo.Density then
            o.Density=Fog.SavedAtmo.Density;o.Offset=Fog.SavedAtmo.Offset
            o.Haze=Fog.SavedAtmo.Haze;o.Glare=Fog.SavedAtmo.Glare
        end
    end
    Fog.SavedAtmo={}
end
