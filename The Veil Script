do
    local function getPlayerList()
        local list={}
        for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer then table.insert(list,p.Name) end end
        if #list==0 then table.insert(list,"(no players)") end
        return list
    end
    local G=Tabs.Misc:AddLeftGroupbox('Spectate')
    G:AddDropdown('SpectateDropdown',{Text='Select Player',Values=getPlayerList(),Default=1})
    G:AddButton('Spectate Selected',function()
        local sel=Options.SpectateDropdown.Value
        if not sel or sel=="(no players)" then Library:Notify('No player selected.',2);return end
        local t=Players:FindFirstChild(sel); if not t then Library:Notify('Player not found.',2);return end
        spectatePlayer(t)
    end)
    G:AddButton('Spectate Nearest',function()
        local mr=getRoot(); if not mr then Library:Notify('No character.',2);return end
        local near,nearD=nil,math.huge
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LocalPlayer then continue end
            local char=p.Character; local root=char and char:FindFirstChild("HumanoidRootPart"); if not root then continue end
            local d=(root.Position-mr.Position).Magnitude; if d<nearD then nearD=d;near=p end
        end
        if near then spectatePlayer(near) else Library:Notify('No players nearby.',2) end
    end)
    G:AddButton('Stop Spectating',function() stopSpectate(); Library:Notify('Stopped spectating.',2) end)
    G:AddButton('Refresh Player List',function() Options.SpectateDropdown:SetValues(getPlayerList()); Library:Notify('Refreshed.',2) end)
    Players.PlayerAdded:Connect(function() task.wait(0.2); pcall(function() Options.SpectateDropdown:SetValues(getPlayerList()) end) end)
    Players.PlayerRemoving:Connect(function() task.wait(0.1); pcall(function() Options.SpectateDropdown:SetValues(getPlayerList()) end) end)
end
