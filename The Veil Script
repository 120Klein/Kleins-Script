-- NPC ESP (workspace.NPCs, name only, orange labels)
-- ============================================================
local function clearNpcESP()
    for _,bb in pairs(NpcESP.Labels) do if bb and bb.Parent then bb:Destroy() end end
    NpcESP.Labels={}
    if NpcESP.Conn    then NpcESP.Conn:Disconnect();    NpcESP.Conn=nil    end
    if NpcESP.AddConn then NpcESP.AddConn:Disconnect(); NpcESP.AddConn=nil end
end
local function addNpcESP(npc)
    if not npc:IsA("Model") or NpcESP.Labels[npc] then return end
    local adorn=npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart or npc:FindFirstChildOfClass("BasePart")
    if not adorn then return end
    NpcESP.Labels[npc]=makeLabel(adorn,npc.Name,Color3.fromRGB(255,170,0))
end
local function refreshNpcESP()
    clearNpcESP()
    if not NpcESP.Enabled then return end
    local folder=workspace:FindFirstChild("NPCs")
    if not folder then Library:Notify('NPCs folder not found.',2); return end
    for _,npc in ipairs(folder:GetChildren()) do addNpcESP(npc) end
    -- Watch for NPCs that get added later
    NpcESP.AddConn=folder.ChildAdded:Connect(function(npc)
        if NpcESP.Enabled then task.wait(0.5); addNpcESP(npc) end
    end)
    -- Heartbeat: hide labels outside max distance
    NpcESP.Conn=RunService.Heartbeat:Connect(function()
        local mr=getRoot()
        for npc,bb in pairs(NpcESP.Labels) do
            if not bb or not bb.Parent then NpcESP.Labels[npc]=nil; continue end
            if not npc or not npc.Parent then bb:Destroy(); NpcESP.Labels[npc]=nil; continue end
            if not mr then bb.Enabled=false; continue end
            local adorn=npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart or npc:FindFirstChildOfClass("BasePart")
            if adorn then
                bb.Enabled=(adorn.Position-mr.Position).Magnitude<=NpcESP.MaxDist
            else
                bb.Enabled=false
            end
        end
    end)
end

